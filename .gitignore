node_modules/

# Machine-specific build and runtime output
/linkerhand_telop_python-master/ros2/build/
/linkerhand_telop_python-master/ros2/install/
/linkerhand_telop_python-master/ros2/log/
/project1yu/pyvut/source/
/tron2_replay_traces/
