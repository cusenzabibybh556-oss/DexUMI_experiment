# Shared rules for a unified Dexumi source repository.
**/.git/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.cache/
.venv*/
venv/
*.egg-info/
.idea/
.vscode/
.env
.env.*
